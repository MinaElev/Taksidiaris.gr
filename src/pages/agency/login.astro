---
export const prerender = false;
import Logo from '@components/Logo.astro';
---
<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Είσοδος γραφείου — Ταξιδιάρης</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      :root {
        --g-700: #047857;
        --g-800: #065f46;
        --g-600: #059669;
        --g-500: #10b981;
        --ink: #0f2c24;
        --muted: #64766f;
        --line: #e3ebe8;
        --field-bg: #f6faf8;
      }
      html, body { height: 100%; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(1200px 600px at 15% -10%, #0a8f68 0%, transparent 55%),
          radial-gradient(1000px 700px at 110% 120%, #023d2e 0%, transparent 50%),
          linear-gradient(135deg, #047857, #05473a);
      }

      /* ---- Card shell ---------------------------------------------------- */
      .card {
        width: 100%;
        max-width: 940px;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 30px 70px -20px rgba(3, 40, 30, 0.55), 0 8px 24px -12px rgba(0,0,0,0.25);
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        animation: rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }
      @keyframes rise {
        from { opacity: 0; transform: translateY(14px) scale(0.99); }
        to   { opacity: 1; transform: none; }
      }

      /* ---- Left brand panel --------------------------------------------- */
      .brandside {
        position: relative;
        padding: 2.75rem 2.5rem;
        color: #eafaf3;
        background:
          radial-gradient(600px 300px at 100% 0%, rgba(16,185,129,0.55) 0%, transparent 60%),
          linear-gradient(160deg, #047857 0%, #065f46 55%, #043d2e 100%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        isolation: isolate;
      }
      .brandside::before,
      .brandside::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        z-index: -1;
        filter: blur(2px);
      }
      .brandside::before {
        width: 240px; height: 240px;
        right: -70px; top: -70px;
        background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.18), transparent 70%);
      }
      .brandside::after {
        width: 180px; height: 180px;
        left: -50px; bottom: -40px;
        background: radial-gradient(circle at 60% 40%, rgba(16,185,129,0.35), transparent 70%);
      }
      .brand-logo { width: 190px; height: auto; }
      .brand-copy h2 {
        margin: 0 0 0.6rem;
        font-size: 1.6rem;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .brand-copy p {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.55;
        color: rgba(234, 250, 243, 0.82);
      }
      .perks { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 0.85rem; }
      .perks li { display: flex; align-items: center; gap: 0.7rem; font-size: 0.92rem; }
      .perks .tick {
        flex: none;
        width: 24px; height: 24px;
        display: grid; place-items: center;
        border-radius: 50%;
        background: rgba(255,255,255,0.16);
        color: #d1fae5;
      }
      .brand-foot { font-size: 0.8rem; color: rgba(234,250,243,0.6); }

      /* ---- Right form panel --------------------------------------------- */
      .formside { padding: 2.75rem 2.5rem; display: flex; flex-direction: column; }
      .badge {
        display: inline-flex; align-items: center; gap: 0.4rem;
        align-self: flex-start;
        font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--g-700);
        background: #e6f6ef;
        padding: 0.3rem 0.7rem; border-radius: 999px;
        margin-bottom: 1.1rem;
      }
      h1 { margin: 0 0 0.35rem; font-size: 1.55rem; font-weight: 800; letter-spacing: -0.02em; }
      .sub { margin: 0 0 1.6rem; color: var(--muted); font-size: 0.95rem; }

      .field { margin-bottom: 1rem; }
      .field label { display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.4rem; color: #3a4a44; }
      .input-wrap { position: relative; display: flex; align-items: center; }
      .input-wrap > svg.lead {
        position: absolute; left: 0.85rem;
        width: 18px; height: 18px; color: #9db2aa; pointer-events: none;
        transition: color 0.15s;
      }
      input {
        width: 100%;
        padding: 0.75rem 0.9rem 0.75rem 2.6rem;
        border: 1.5px solid var(--line);
        border-radius: 11px;
        font-size: 0.98rem;
        font-family: inherit;
        color: var(--ink);
        background: var(--field-bg);
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
      }
      input::placeholder { color: #a9bab3; }
      input:focus {
        outline: none;
        border-color: var(--g-600);
        background: #fff;
        box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.14);
      }
      .input-wrap:focus-within > svg.lead { color: var(--g-600); }
      .toggle-pw {
        position: absolute; right: 0.5rem;
        display: grid; place-items: center;
        width: 34px; height: 34px;
        border: none; background: transparent; cursor: pointer;
        color: #9db2aa; border-radius: 8px; padding: 0;
      }
      .toggle-pw:hover { color: var(--g-700); background: #eef6f2; }

      button.primary {
        width: 100%;
        margin-top: 0.4rem;
        padding: 0.85rem;
        background: linear-gradient(135deg, var(--g-600), var(--g-700));
        color: #fff; border: none; border-radius: 11px;
        font-weight: 700; font-size: 1rem; font-family: inherit;
        cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        box-shadow: 0 10px 22px -8px rgba(4, 120, 87, 0.7);
        transition: transform 0.12s, box-shadow 0.15s, filter 0.15s;
      }
      button.primary:hover { transform: translateY(-1px); box-shadow: 0 14px 28px -8px rgba(4, 120, 87, 0.75); filter: brightness(1.03); }
      button.primary:active { transform: translateY(0); }
      button:disabled { opacity: 0.7; cursor: not-allowed; }

      .divider { display: flex; align-items: center; gap: 0.85rem; margin: 1.25rem 0; color: #9db2aa; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }

      button.ghost {
        width: 100%;
        padding: 0.72rem;
        background: #fff; color: var(--g-700);
        border: 1.5px solid var(--line); border-radius: 11px;
        font-weight: 600; font-size: 0.92rem; font-family: inherit;
        cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        transition: border-color 0.15s, background 0.15s, color 0.15s;
      }
      button.ghost:hover { border-color: var(--g-500); background: #f2fbf7; }

      /* spinner + loading state */
      .spinner {
        width: 17px; height: 17px; display: none;
        border: 2.5px solid rgba(255,255,255,0.45);
        border-top-color: #fff; border-radius: 50%;
        animation: spin 0.7s linear infinite;
      }
      button.ghost .spinner { border-color: rgba(4,120,87,0.35); border-top-color: var(--g-700); }
      button.loading .btn-label { display: none; }
      button.loading .spinner { display: inline-block; }
      @keyframes spin { to { transform: rotate(360deg); } }

      .msg { font-size: 0.9rem; margin-top: 1rem; padding: 0.75rem 0.9rem; border-radius: 10px; display: flex; gap: 0.5rem; align-items: flex-start; line-height: 1.4; }
      .msg.ok  { background: #d9f5e8; color: #065f46; }
      .msg.err { background: #fdeaea; color: #9b1c1c; }
      .msg:empty { display: none; }

      .foot { margin-top: auto; padding-top: 1.6rem; font-size: 0.88rem; color: var(--muted); }
      .foot a { color: var(--g-700); text-decoration: none; font-weight: 700; }
      .foot a:hover { text-decoration: underline; }
      .back { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.6rem; color: #93a49d; font-size: 0.82rem; text-decoration: none; }
      .back:hover { color: var(--g-700); }

      /* ---- Responsive ---------------------------------------------------- */
      @media (max-width: 820px) {
        .card { grid-template-columns: 1fr; max-width: 460px; }
        .brandside { padding: 2rem 2rem 1.75rem; }
        .brand-logo { width: 160px; }
        .brand-copy h2 { font-size: 1.35rem; }
        .perks, .brand-foot { display: none; }
        .brandside { flex-direction: row; align-items: center; justify-content: space-between; gap: 1rem; }
        .formside { padding: 2rem 1.75rem 2.25rem; }
      }
      @media (max-width: 420px) {
        body { padding: 0; }
        .card { border-radius: 0; min-height: 100vh; box-shadow: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .card { animation: none; }
        .spinner { animation-duration: 1.2s; }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <!-- Brand panel -->
      <aside class="brandside">
        <Logo variant="light" class="brand-logo" />
        <div class="brand-copy">
          <h2>Πύλη Συνεργατών</h2>
          <p>Διαχειρίσου τις εκδρομές σου, το προφίλ του γραφείου και πρόβαλέ τα σε χιλιάδες ταξιδιώτες.</p>
          <ul class="perks">
            <li><span class="tick"><svg viewBox="0 0 20 20" width="12" height="12" fill="currentColor"><path d="M7.5 13.5l-3.5-3.5 1.4-1.4 2.1 2.1 5.1-5.1 1.4 1.4z"/></svg></span> Ανάρτηση & διαχείριση εκδρομών</li>
            <li><span class="tick"><svg viewBox="0 0 20 20" width="12" height="12" fill="currentColor"><path d="M7.5 13.5l-3.5-3.5 1.4-1.4 2.1 2.1 5.1-5.1 1.4 1.4z"/></svg></span> Δικό σου προφίλ & στοιχεία επικοινωνίας</li>
            <li><span class="tick"><svg viewBox="0 0 20 20" width="12" height="12" fill="currentColor"><path d="M7.5 13.5l-3.5-3.5 1.4-1.4 2.1 2.1 5.1-5.1 1.4 1.4z"/></svg></span> Προβολή σε στοχευμένο κοινό</li>
          </ul>
        </div>
        <p class="brand-foot">Ταξιδιάρης — Ταξιδιωτικό γραφείο &amp; οδηγός</p>
      </aside>

      <!-- Form panel -->
      <main class="formside">
        <span class="badge">
          <svg viewBox="0 0 20 20" width="13" height="13" fill="currentColor"><path d="M10 2a4 4 0 014 4v2h1a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2h1V6a4 4 0 014-4zm2 6V6a2 2 0 10-4 0v2h4z"/></svg>
          Ασφαλής είσοδος
        </span>
        <h1>Καλώς ήρθες πίσω</h1>
        <p class="sub">Συνδέσου στον λογαριασμό του γραφείου σου.</p>

        <form id="loginForm" novalidate>
          <div class="field">
            <label for="email">Email</label>
            <div class="input-wrap">
              <svg class="lead" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              <input type="email" id="email" name="email" required autofocus placeholder="info@grafeio.gr" autocomplete="email" />
            </div>
          </div>

          <div class="field">
            <label for="password">Κωδικός</label>
            <div class="input-wrap">
              <svg class="lead" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
              <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••" />
              <button type="button" class="toggle-pw" id="togglePw" aria-label="Εμφάνιση κωδικού">
                <svg id="eyeIcon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <button type="submit" class="primary" id="submitBtn">
            <span class="btn-label">Σύνδεση</span>
            <span class="spinner"></span>
          </button>
        </form>

        <div class="divider">ή</div>

        <button type="button" class="ghost" id="magicBtn">
          <span class="btn-label">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-3px;margin-right:2px"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            Ξέχασα τον κωδικό · Στείλε σύνδεσμο email
          </span>
          <span class="spinner"></span>
        </button>

        <div class="msg" id="msg"></div>

        <div class="foot">
          Νέο γραφείο; <a href="/agency/signup">Δημιούργησε λογαριασμό</a>
          <br />
          <a class="back" href="/">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            Επιστροφή στο site
          </a>
        </div>
      </main>
    </div>

    <script is:inline>
      const msg = document.getElementById('msg');
      const submitBtn = document.getElementById('submitBtn');
      const magicBtn = document.getElementById('magicBtn');
      const emailEl = document.getElementById('email');
      const passwordEl = document.getElementById('password');
      const togglePw = document.getElementById('togglePw');
      const eyeIcon = document.getElementById('eyeIcon');

      const EYE = '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>';
      const EYE_OFF = '<path d="M9.9 4.24A9.1 9.1 0 0 1 12 4c6.5 0 10 8 10 8a18 18 0 0 1-2.16 3.19M6.6 6.6A18 18 0 0 0 2 12s3.5 8 10 8a9 9 0 0 0 5.4-1.6"/><path d="m2 2 20 20"/>';

      togglePw.addEventListener('click', () => {
        const show = passwordEl.type === 'password';
        passwordEl.type = show ? 'text' : 'password';
        eyeIcon.innerHTML = show ? EYE_OFF : EYE;
        togglePw.setAttribute('aria-label', show ? 'Απόκρυψη κωδικού' : 'Εμφάνιση κωδικού');
      });

      function showError(text) { msg.className = 'msg err'; msg.textContent = text; }
      function showOk(text) { msg.className = 'msg ok'; msg.textContent = text; }
      function clearMsg() { msg.className = 'msg'; msg.textContent = ''; }
      function setLoading(btn, on) { btn.classList.toggle('loading', on); btn.disabled = on; }

      // Password sign-in
      document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        clearMsg();
        setLoading(submitBtn, true);
        try {
          const r = await fetch('/api/agency/auth/password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailEl.value.trim(), password: passwordEl.value }),
          });
          const j = await r.json().catch(() => ({}));
          if (r.ok) {
            showOk('✓ Συνδέθηκες, μετάβαση…');
            setTimeout(() => { window.location.href = j.redirectTo || '/agency'; }, 600);
          } else {
            showError(j.error || ('Σφάλμα ' + r.status));
            setLoading(submitBtn, false);
          }
        } catch (ex) {
          showError('Πρόβλημα δικτύου: ' + (ex && ex.message ? ex.message : ex));
          setLoading(submitBtn, false);
        }
      });

      // Magic-link fallback
      magicBtn.addEventListener('click', async () => {
        const email = emailEl.value.trim();
        if (!email) { showError('Συμπλήρωσε πρώτα το email σου'); emailEl.focus(); return; }
        clearMsg();
        setLoading(magicBtn, true);
        try {
          const r = await fetch('/api/agency/auth/magic-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
          if (r.ok) {
            showOk('✓ Αν ο λογαριασμός υπάρχει, στάλθηκε email με σύνδεσμο σύνδεσης. Έλεγξε τα εισερχόμενα (και το spam).');
          } else {
            const j = await r.json().catch(() => ({}));
            showError(j.error || ('Σφάλμα ' + r.status));
          }
        } catch (ex) {
          showError('Πρόβλημα δικτύου: ' + (ex && ex.message ? ex.message : ex));
        } finally {
          setLoading(magicBtn, false);
        }
      });
    </script>
  </body>
</html>
